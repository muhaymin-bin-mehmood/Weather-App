# OpenWeatherMap — https://home.openweathermap.org/api_keys (free plan)
# Optional: without it the app uses Open-Meteo for all weather data.
VITE_OWM_KEY=

# GeoDB Cities on RapidAPI — https://rapidapi.com/wirefreethought/api/geodb-cities (Basic, free)
# Optional: without it city search falls back to Open-Meteo geocoding.
VITE_RAPIDAPI_KEY=
